{
  "id": "./",
  "name": "Mother City",
  "short_name": "Mother City",
  "description": "An open-world Cape Town adventure.",
  "start_url": "./index.html?source=app",
  "scope": "./",
  "display": "fullscreen",
  "display_override": ["fullscreen", "standalone"],
  "orientation": "landscape",
  "background_color": "#0d1b2a",
